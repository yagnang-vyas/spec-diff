{
  "name": "specdiff",
  "version": "0.1.0",
  "description": "Compare two OpenAPI 3.x documents and classify every change as breaking, warning or safe.",
  "license": "MIT",
  "author": "Yagnang Vyas",
  "type": "module",
  "bin": {
    "specdiff": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run build && publint && npm run test"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
